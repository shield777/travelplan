rules_version = '2';

// 여행일정 앱 보안 규칙
// - 구글로 로그인한 사람 중, 가족(families) 문서의 members에 이메일이 있는 사람만 그 가족의 여행을 읽고 쓸 수 있어요.
// - 가족 구성원 추가·삭제는 가족을 만든 사람(owner)만 할 수 있어요.
// - 이메일 목록은 이 파일이 아니라 Firestore 안에만 저장돼서, 공개 저장소에 드러나지 않아요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isMember(fam) {
      return signedIn()
        && myEmail() in get(/databases/$(database)/documents/families/$(fam)).data.members;
    }

    match /families/{fam} {
      // 내가 들어 있는 가족만 찾고 읽을 수 있어요
      allow read: if signedIn() && myEmail() in resource.data.members;

      // 가족 만들기: 만든 사람이 owner이고, 본인 이메일이 구성원에 있어야 해요 (최대 10명)
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && myEmail() in request.resource.data.members
        && request.resource.data.members.size() <= 10;

      // 구성원 바꾸기·가족 지우기는 owner만. owner는 바꿀 수 없어요
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && myEmail() in request.resource.data.members
        && request.resource.data.members.size() <= 10;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // 가족의 여행: 구성원 누구나 읽고 고칠 수 있어요
      match /trips/{trip} {
        allow read, write: if isMember(fam);
      }
    }

    // 그 밖의 모든 곳은 막아요
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
