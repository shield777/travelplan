rules_version = '2';

// 여행일정 앱 보안 규칙
// - 구글로 로그인한 사람 중, 가족(families) 문서의 members에 이메일이 있는 사람만 그 가족의 여행을 읽을 수 있어요.
// - 여행을 고치거나 지우는 건 가족을 만든 사람(owner)과, owner가 권한을 준 사람(editors)만 할 수 있어요.
// - 가족 구성원 추가·삭제와 권한 주기는 owner만 할 수 있어요.
// - 링크로 보는 사람용 사본(public)은 문서 번호(가족 번호 + 여행 번호)를 아는 사람이면 로그인 없이 읽을 수 있어요.
//   목록 조회는 막혀 있어서 번호를 모르면 찾을 수 없고, 예약번호·숙소 예약번호·경비는 사본에 들어가지 않아요.
// - 이메일 목록은 이 파일이 아니라 Firestore 안에만 저장돼서, 공개 저장소에 드러나지 않아요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function famDoc(fam) {
      return get(/databases/$(database)/documents/families/$(fam)).data;
    }
    function isMember(fam) {
      return signedIn() && myEmail() in famDoc(fam).members;
    }
    function canEdit(fam) {
      let f = famDoc(fam);
      return signedIn() && myEmail() in f.members
        && (f.owner == request.auth.uid || myEmail() in f.get('editors', []));
    }

    match /families/{fam} {
      // 내가 들어 있는 가족만 찾고 읽을 수 있어요
      allow read: if signedIn() && myEmail() in resource.data.members;

      // 가족 만들기: 만든 사람이 owner이고, 본인 이메일이 구성원에 있어야 해요 (최대 10명)
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && myEmail() in request.resource.data.members
        && request.resource.data.members.size() <= 10;

      // 구성원 바꾸기·가족 지우기는 owner만. owner는 바꿀 수 없어요
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && myEmail() in request.resource.data.members
        && request.resource.data.members.size() <= 10
        && request.resource.data.get('editors', []).size() <= 10;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // 가족의 여행: 구성원은 누구나 읽고, 고치기·지우기는 owner와 권한 받은 사람만
      match /trips/{trip} {
        allow read: if isMember(fam);
        allow write: if canEdit(fam);
      }

      // 링크로 보는 사람용 사본: 번호를 알면 누구나 읽기(한 건씩만), 쓰기는 owner와 권한 받은 사람만
      match /public/{trip} {
        allow get: if true;
        allow write: if canEdit(fam);
      }
    }

    // 그 밖의 모든 곳은 막아요
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
